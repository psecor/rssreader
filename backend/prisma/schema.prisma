// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  googleId     String        @unique
  email        String        @unique
  name         String?
  refreshToken String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  feeds        Feed[]
  readStatus   ReadStatus[]
  subscription Subscription?
}

// Access gate for API routes. Users without an active/grace_period row are
// blocked by the subscription-check middleware. Founders have source='founder'
// and null expiresAt; store-purchased subs have source='google_play'/'app_store'
// with externalId (Play purchaseToken or Apple originalTransactionId) and
// expiresAt from the store event.
model Subscription {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String // active, past_due, cancelled, expired, grace_period
  source     String // google_play, app_store, founder
  externalId String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([externalId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeds     Feed[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Feed {
  id             Int        @id @default(autoincrement())
  title          String
  url            String
  description    String?
  categoryId     Int
  userId         Int
  lastFetchedAt  DateTime?
  lastFetchError String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  category       Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          FeedItem[]

  @@unique([userId, url])
}

model FeedItem {
  id          Int          @id @default(autoincrement())
  feedId      Int
  title       String
  link        String
  description String?
  contentHtml String?
  author      String?
  pubDate     DateTime?
  guid        String
  thumbnail   String?
  createdAt   DateTime     @default(now())
  feed        Feed         @relation(fields: [feedId], references: [id], onDelete: Cascade)
  readStatus  ReadStatus[]

  @@unique([feedId, guid])
  @@index([feedId, pubDate])
}

model ReadStatus {
  id         Int       @id @default(autoincrement())
  feedItemId Int
  userId     Int
  isRead     Boolean   @default(false)
  readAt     DateTime?
  openedAt   DateTime?
  updatedAt  DateTime  @default(now()) @updatedAt
  feedItem   FeedItem  @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedItemId, userId])
  @@index([userId, isRead])
  @@index([userId, updatedAt])
}
