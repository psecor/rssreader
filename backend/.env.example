DATABASE_URL="postgresql://user:password@localhost:5432/rssreader"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
SESSION_SECRET="your-session-secret-change-this-in-production"
# Used to sign 90-day bearer tokens issued to the mobile client. Generate
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-jwt-secret-change-this-in-production"
FRONTEND_URL="http://localhost:3000"
PORT=3001
NODE_ENV="development"

# Comma-separated list of Google account emails permitted to log in. Required —
# the app refuses to start if unset, and refuses to authenticate any address
# not on this list.
ALLOWED_EMAILS="you@example.com"
